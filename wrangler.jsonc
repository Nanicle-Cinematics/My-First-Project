cloudflare/workers-autoconfig
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-first-project",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
=======
// Cloudflare Workers config for the marketing landing page.
// The Express server (server.js) is NOT deployed here — that lives on Fly.io.
// This config tells Cloudflare to serve the static files in ./marketing as a
// plain website. No Worker code, no build step.
{
  "name": "mychurchmanager",
  "compatibility_date": "2026-05-29",
  "assets": {
    "directory": "./marketing",
    "not_found_handling": "404-page"
  }
main
}
