# Church Manager environment template.
# Copy to .env for local notes, or set these as deployment secrets/env vars.

NODE_ENV=development
PORT=3000

# Core app identity
CHURCH_NAME="Dunwell Methodist"
PUBLIC_URL=http://localhost:3000
MEMBER_ID_PREFIX=DMS

# Required outside tests. Use a long random value:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Database and local storage
CHURCH_DB=./church.db
PHOTO_DIR=./photos
BACKUP_DIR=./backups
BACKUP_KEEP=12

# Production safety valve. Leave unset except when intentionally initializing a
# brand-new production database on first boot.
ALLOW_DB_INIT=

# Optional off-site backup destination. If it contains a query string, it is
# treated as a presigned PUT URL; otherwise backup filenames are appended.
BACKUP_UPLOAD_URL=

# Support and alert routing
SUPPORT_EMAIL=support@example.com
ALERT_EMAIL=alerts@example.com
ALERT_WEBHOOK_URL=

# SMS provider: Arkesel. Leave ARKESEL_API_KEY empty for dry-run mode.
ARKESEL_API_KEY=
ARKESEL_SENDER=DUNWELL

# SMTP email provider. Leave incomplete for dry-run mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Resend email provider API key.
RESEND_API_KEY=

# Birthday automation
BIRTHDAY_HOUR=7
BIRTHDAY_TEMPLATE="Happy birthday, {first_name}! May God bless your year ahead. - {church_name}"
