# Church Manager environment template.
# Copy to .env for local notes, or set these as deployment secrets/env vars.

NODE_ENV=development
PORT=3000

# Core app identity
CHURCH_NAME="Dunwell Methodist"
PUBLIC_URL=http://localhost:3000
MEMBER_ID_PREFIX=DMS

# Required outside tests. Use a long random value:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL database and persistent file storage
# Use a dedicated non-production database when running the integration suite.
DATABASE_URL=postgresql://user:password@localhost:5432/church_manager
PHOTO_DIR=./photos

# Support and alert routing
SUPPORT_EMAIL=support@example.com
ALERT_EMAIL=alerts@example.com
ALERT_WEBHOOK_URL=

# SMS provider: Arkesel. Leave ARKESEL_API_KEY empty for dry-run mode.
ARKESEL_API_KEY=
ARKESEL_SENDER=DUNWELL

# SMTP email provider. Leave incomplete for dry-run mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Resend email provider API key.
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=0

# PostgreSQL backup and restore drill
BACKUP_DIR=./backups/postgres
BACKUP_KEEP_DAYS=30
BACKUP_UPLOAD_URL=
RESTORE_DRILL_DATABASE_URL=
ALLOW_RESTORE_DRILL=0

# Birthday automation
BIRTHDAY_HOUR=7
BIRTHDAY_TEMPLATE="Happy birthday, {first_name}! May God bless your year ahead. - {church_name}"
