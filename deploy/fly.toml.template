# Fly.io config template for a new church installation.
# Generated by deploy/new-church.sh — DO NOT edit the rendered copy by hand;
# re-run the script if you need to change app name, region, or VM size.

app            = '__APP_NAME__'
primary_region = '__REGION__'

[build]

[env]
  NODE_ENV  = 'production'
  CHURCH_DB = '/data/church.db'
  PHOTO_DIR = '/data/photos'

[[mounts]]
  source      = 'church_data'
  destination = '/data'

[http_service]
  internal_port = 3000
  force_https   = true
  auto_stop_machines  = 'stop'
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    interval = '15s'
    timeout = '2s'
    grace_period = '20s'
    method = 'get'
    path = '/healthz'

  [[http_service.checks]]
    interval = '30s'
    timeout = '3s'
    grace_period = '25s'
    method = 'get'
    path = '/readyz'

[[vm]]
  memory = '__MEMORY__'
  cpus   = 1
