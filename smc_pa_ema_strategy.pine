//@version=6
strategy("SMC + PA + EMA Pro Scalper Strategy", shorttitle="SMC·PA·STRAT", overlay=true,
          initial_capital   = 10000,
          default_qty_type  = strategy.percent_of_equity,
          default_qty_value = 2,
          commission_type   = strategy.commission.percent,
          commission_value  = 0.0,
          slippage          = 1,
          pyramiding        = 0,
          calc_on_every_tick = false,
          process_orders_on_close = true,
          max_labels_count  = 500,
          max_lines_count   = 500,
          max_boxes_count   = 100)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════
grp_ema    = "── EMA / Trend ──"
grp_mom    = "── Momentum / Filters ──"
grp_smc    = "── SMC ──"
grp_risk   = "── Risk / SL-TP ──"
grp_sess   = "── Session Filter ──"
grp_strat  = "── Strategy Mode ──"
grp_vis    = "── Visuals ──"

ema_fast   = input.int(8,   "EMA Fast",            minval=1, group=grp_ema)
ema_mid    = input.int(21,  "EMA Mid",             minval=1, group=grp_ema)
ema_slow   = input.int(50,  "EMA Slow",            minval=1, group=grp_ema)
htf_tf     = input.timeframe("60", "HTF Trend TF",            group=grp_ema)
htf_len    = input.int(200, "HTF EMA Length",      minval=10, group=grp_ema)

rsi_len    = input.int(14,  "RSI Length",          minval=2,  group=grp_mom)
rsi_buy_min  = input.int(45, "RSI Buy Min",        minval=1, maxval=99, group=grp_mom)
rsi_buy_max  = input.int(70, "RSI Buy Max",        minval=1, maxval=99, group=grp_mom)
rsi_sell_min = input.int(30, "RSI Sell Min",       minval=1, maxval=99, group=grp_mom)
rsi_sell_max = input.int(55, "RSI Sell Max",       minval=1, maxval=99, group=grp_mom)
adx_len    = input.int(14,  "ADX Length",          minval=2,  group=grp_mom)
adx_min    = input.float(20, "ADX Minimum",        minval=0,  group=grp_mom)
atr_min_mult = input.float(0.6, "ATR Min Mult (avg)", minval=0.1, step=0.1, group=grp_mom)
atr_max_mult = input.float(2.5, "ATR Max Mult (avg)", minval=0.5, step=0.1, group=grp_mom)
body_min_pct = input.float(0.55, "Min Body/Range", minval=0.1, maxval=1.0, step=0.05, group=grp_mom)
cooldown_bars = input.int(8, "Signal Cooldown (bars)", minval=0, group=grp_mom)

swing_len  = input.int(5,   "Swing Pivot Length",  minval=2, group=grp_smc)
ob_lb      = input.int(10,  "Order Block Lookback", minval=3, group=grp_smc)

sl_atr_mult   = input.float(1.2, "SL × ATR",     minval=0.1, step=0.1, group=grp_risk)
tp_atr_mult   = input.float(1.0, "TP × ATR",     minval=0.1, step=0.1, group=grp_risk)
use_be        = input.bool(true, "Move SL to Break-Even at 0.5×ATR profit", group=grp_risk)
be_trigger_r  = input.float(0.5, "Break-Even Trigger (×ATR)", minval=0.1, step=0.1, group=grp_risk)
trade_strong_only = input.bool(true, "Trade Strong Signals Only", group=grp_strat)
max_trades_day = input.int(5, "Max Trades Per Day", minval=1, group=grp_strat)

use_session = input.bool(true, "Use Session Filter",            group=grp_sess)
session_str = input.session("0700-1600", "Trading Session (UTC)", group=grp_sess)

show_ob    = input.bool(true, "Show Order Blocks",   group=grp_vis)
show_bos   = input.bool(true, "Show BOS / CHoCH",    group=grp_vis)
show_dash  = input.bool(true, "Show Dashboard",      group=grp_vis)
show_bg    = input.bool(true, "Trend Background",    group=grp_vis)
show_emas  = input.bool(true, "Show EMAs",           group=grp_vis)

bull_col   = input.color(color.new(#00c853, 0), "Bullish Color", group=grp_vis)
bear_col   = input.color(color.new(#d50000, 0), "Bearish Color", group=grp_vis)
ema_col_f  = input.color(color.new(#ffeb3b, 0), "EMA Fast Color", group=grp_vis)
ema_col_m  = input.color(color.new(#ff9800, 0), "EMA Mid Color",  group=grp_vis)
ema_col_s  = input.color(color.new(#03a9f4, 0), "EMA Slow Color", group=grp_vis)

// ══════════════════════════════════════════════════════════════
// CORE INDICATORS
// ══════════════════════════════════════════════════════════════
ema_f = ta.ema(close, ema_fast)
ema_m = ta.ema(close, ema_mid)
ema_s = ta.ema(close, ema_slow)
atr   = ta.atr(14)
atr_avg = ta.sma(atr, 50)
rsi   = ta.rsi(close, rsi_len)
[diPlus, diMinus, adx] = ta.dmi(adx_len, adx_len)

htf_ema = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_len), lookahead=barmerge.lookahead_off)

plot(show_emas ? ema_f : na, "EMA Fast", ema_col_f, 1)
plot(show_emas ? ema_m : na, "EMA Mid",  ema_col_m, 2)
plot(show_emas ? ema_s : na, "EMA Slow", ema_col_s, 2)

ema_stack_bull = ema_f > ema_m and ema_m > ema_s and close > ema_f
ema_stack_bear = ema_f < ema_m and ema_m < ema_s and close < ema_f

htf_bull = close > htf_ema
htf_bear = close < htf_ema

// ══════════════════════════════════════════════════════════════
// GATES
// ══════════════════════════════════════════════════════════════
in_session = not use_session or not na(time(timeframe.period, session_str + ":1234567"))
vol_ok     = atr >= atr_avg * atr_min_mult and atr <= atr_avg * atr_max_mult
adx_ok     = adx >= adx_min

// ══════════════════════════════════════════════════════════════
// SWINGS
// ══════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low,   swing_len, swing_len)

var float sh1 = na, var int sh1_bar = na
var float sl1 = na, var int sl1_bar = na

if not na(ph)
    sh1 := ph,  sh1_bar := bar_index - swing_len

if not na(pl)
    sl1 := pl,  sl1_bar := bar_index - swing_len

// ══════════════════════════════════════════════════════════════
// BOS / CHoCH
// ══════════════════════════════════════════════════════════════
var bool in_uptrend = false
var bool in_downtrend = false
var string ms_label = "Neutral"

bull_bos   = not na(sh1) and close > sh1 and close[1] <= sh1
bear_bos   = not na(sl1) and close < sl1 and close[1] >= sl1
choch_bull = bull_bos and in_downtrend
choch_bear = bear_bos and in_uptrend

if bull_bos
    ms_label := choch_bull ? "CHoCH Bull" : "BOS Bull"
    in_uptrend := true, in_downtrend := false

if bear_bos
    ms_label := choch_bear ? "CHoCH Bear" : "BOS Bear"
    in_downtrend := true, in_uptrend := false

if show_bos and bull_bos
    label.new(bar_index, low - atr * 1.5, choch_bull ? "CHoCH ▲" : "BOS ▲",
              style=label.style_label_up,
              color=choch_bull ? color.new(#e040fb, 0) : bull_col,
              textcolor=color.white, size=size.small)

if show_bos and bear_bos
    label.new(bar_index, high + atr * 1.5, choch_bear ? "CHoCH ▼" : "BOS ▼",
              style=label.style_label_down,
              color=choch_bear ? color.new(#e040fb, 0) : bear_col,
              textcolor=color.white, size=size.small)

// ══════════════════════════════════════════════════════════════
// ORDER BLOCKS
// ══════════════════════════════════════════════════════════════
var float bull_ob_hi = na, var float bull_ob_lo = na, var int bull_ob_l = na
var float bear_ob_hi = na, var float bear_ob_lo = na, var int bear_ob_l = na

if bull_bos
    for i = 1 to ob_lb
        if close[i] < open[i]
            bull_ob_hi := high[i]
            bull_ob_lo := low[i]
            bull_ob_l  := bar_index - i
            break

if bear_bos
    for i = 1 to ob_lb
        if close[i] > open[i]
            bear_ob_hi := high[i]
            bear_ob_lo := low[i]
            bear_ob_l  := bar_index - i
            break

var box bull_ob_box = na, var box bear_ob_box = na

if show_ob and bull_bos and not na(bull_ob_l)
    if not na(bull_ob_box)
        box.delete(bull_ob_box)
    bull_ob_box := box.new(bull_ob_l, bull_ob_hi, bar_index + 30, bull_ob_lo,
                           border_color=color.new(bull_col, 20),
                           bgcolor=color.new(bull_col, 78), border_width=1)

if show_ob and bear_bos and not na(bear_ob_l)
    if not na(bear_ob_box)
        box.delete(bear_ob_box)
    bear_ob_box := box.new(bear_ob_l, bear_ob_hi, bar_index + 30, bear_ob_lo,
                           border_color=color.new(bear_col, 20),
                           bgcolor=color.new(bear_col, 78), border_width=1)

if show_ob and not na(bull_ob_box)
    box.set_right(bull_ob_box, bar_index + 30)
if show_ob and not na(bear_ob_box)
    box.set_right(bear_ob_box, bar_index + 30)

in_bull_ob = not na(bull_ob_hi) and low <= bull_ob_hi and high >= bull_ob_lo
in_bear_ob = not na(bear_ob_hi) and low <= bear_ob_hi and high >= bear_ob_lo

// ══════════════════════════════════════════════════════════════
// PRICE ACTION
// ══════════════════════════════════════════════════════════════
body       = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low
rng        = high - low
body_pct   = rng > 0 ? body / rng : 0
close_top  = rng > 0 ? (close - low) / rng >= 0.66 : false
close_bot  = rng > 0 ? (high - close) / rng >= 0.66 : false

bull_engulf = close > open and close[1] < open[1] and open < close[1] and close > open[1] and body > body[1] * 0.9 and body_pct >= body_min_pct
bear_engulf = close < open and close[1] > open[1] and open > close[1] and close < open[1] and body > body[1] * 0.9 and body_pct >= body_min_pct
hammer      = lower_wick >= body * 2.0 and upper_wick <= body * 0.5 and rng > 0 and close >= open and close_top
shoot_star  = upper_wick >= body * 2.0 and lower_wick <= body * 0.5 and rng > 0 and close <= open and close_bot
strong_bull = close > open and body_pct >= body_min_pct and close_top
strong_bear = close < open and body_pct >= body_min_pct and close_bot

bull_pa = bull_engulf or hammer or strong_bull
bear_pa = bear_engulf or shoot_star or strong_bear

near_sup = false
near_res = false

// ══════════════════════════════════════════════════════════════
// MOMENTUM
// ══════════════════════════════════════════════════════════════
rsi_buy_ok  = rsi >= rsi_buy_min  and rsi <= rsi_buy_max  and rsi > rsi[1]
rsi_sell_ok = rsi >= rsi_sell_min and rsi <= rsi_sell_max and rsi < rsi[1]

// ══════════════════════════════════════════════════════════════
// SCORING
// ══════════════════════════════════════════════════════════════
long_score = 0
long_score += ema_stack_bull   ? 1 : 0
long_score += htf_bull         ? 1 : 0
long_score += in_uptrend       ? 1 : 0
long_score += bull_pa          ? 1 : 0
long_score += rsi_buy_ok       ? 1 : 0
long_score += in_bull_ob       ? 1 : 0
long_score += (bull_bos or choch_bull) ? 1 : 0

short_score = 0
short_score += ema_stack_bear  ? 1 : 0
short_score += htf_bear        ? 1 : 0
short_score += in_downtrend    ? 1 : 0
short_score += bear_pa         ? 1 : 0
short_score += rsi_sell_ok     ? 1 : 0
short_score += in_bear_ob      ? 1 : 0
short_score += (bear_bos or choch_bear) ? 1 : 0

gates_ok = in_session and vol_ok and adx_ok

// Per-day trade limit
var int day_trades = 0
new_day = ta.change(dayofmonth) != 0
if new_day
    day_trades := 0
day_limit_ok = day_trades < max_trades_day

// Cooldown
var int last_sig_bar = na
can_fire = na(last_sig_bar) or (bar_index - last_sig_bar) >= cooldown_bars

buy_strong  = gates_ok and can_fire and day_limit_ok and long_score  >= 5 and ema_stack_bull and htf_bull and bull_pa
sell_strong = gates_ok and can_fire and day_limit_ok and short_score >= 5 and ema_stack_bear and htf_bear and bear_pa
buy_med     = gates_ok and can_fire and day_limit_ok and long_score  == 4 and ema_stack_bull and bull_pa and not buy_strong
sell_med    = gates_ok and can_fire and day_limit_ok and short_score == 4 and ema_stack_bear and bear_pa and not sell_strong

go_long  = trade_strong_only ? buy_strong  : (buy_strong  or buy_med)
go_short = trade_strong_only ? sell_strong : (sell_strong or sell_med)

if go_long or go_short
    last_sig_bar := bar_index
    day_trades   := day_trades + 1

// ══════════════════════════════════════════════════════════════
// STRATEGY ENTRIES & EXITS
// ══════════════════════════════════════════════════════════════
var float entry_price = na
var float sl_price    = na
var float tp_price    = na
var bool  be_moved    = false

if go_long and strategy.position_size == 0
    entry_price := close
    sl_price    := close - atr * sl_atr_mult
    tp_price    := close + atr * tp_atr_mult
    be_moved    := false
    strategy.entry("Long", strategy.long)

if go_short and strategy.position_size == 0
    entry_price := close
    sl_price    := close + atr * sl_atr_mult
    tp_price    := close - atr * tp_atr_mult
    be_moved    := false
    strategy.entry("Short", strategy.short)

// Break-even logic
if use_be and strategy.position_size > 0 and not be_moved
    if high >= entry_price + atr * be_trigger_r
        sl_price := entry_price
        be_moved := true

if use_be and strategy.position_size < 0 and not be_moved
    if low <= entry_price - atr * be_trigger_r
        sl_price := entry_price
        be_moved := true

if strategy.position_size > 0
    strategy.exit("ExitL", from_entry="Long", stop=sl_price, limit=tp_price)

if strategy.position_size < 0
    strategy.exit("ExitS", from_entry="Short", stop=sl_price, limit=tp_price)

// Close at end of session (avoid carrying scalps)
session_ending = use_session and na(time(timeframe.period, session_str + ":1234567")) and strategy.position_size != 0
if session_ending
    strategy.close_all(comment="Session End")

// ══════════════════════════════════════════════════════════════
// VISUAL MARKERS
// ══════════════════════════════════════════════════════════════
plotshape(go_long,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=bull_col, size=size.small)
plotshape(go_short, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=bear_col, size=size.small)

plot(strategy.position_size != 0 ? sl_price : na, "SL", color.new(color.red, 0),   2, plot.style_linebr)
plot(strategy.position_size != 0 ? tp_price : na, "TP", color.new(color.green, 0), 2, plot.style_linebr)

// ══════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 12,
                            bgcolor      = color.new(color.black, 15),
                            border_color = color.new(color.gray, 40),
                            border_width = 1,
                            frame_color  = color.new(color.gray, 20),
                            frame_width  = 2)

f_row(col, row, lbl, val, val_col, val_bg) =>
    table.cell(dash, col,     row, lbl, text_color=color.new(color.gray, 0),
               bgcolor=color.new(color.black, 40), text_size=size.small,
               text_halign=text.align_left)
    table.cell(dash, col + 1, row, val, text_color=val_col, bgcolor=val_bg,
               text_size=size.small, text_halign=text.align_center)

if show_dash and barstate.islast
    table.cell(dash, 0, 0, "Pro Scalper Strategy",
               text_color=color.white, bgcolor=color.new(#1a237e, 10),
               text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period,
               text_color=color.yellow, bgcolor=color.new(#1a237e, 10),
               text_size=size.small, text_halign=text.align_center)

    wins   = strategy.wintrades
    losses = strategy.losstrades
    total  = strategy.closedtrades
    wr     = total > 0 ? (wins / total) * 100 : 0.0
    pf     = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0
    net    = strategy.netprofit

    f_row(0, 1, " Total Trades", str.tostring(total), color.white, color.new(color.gray, 60))

    wr_bg = wr >= 70 ? color.new(bull_col, 30) : wr >= 55 ? color.new(#ff9800, 40) : color.new(bear_col, 40)
    f_row(0, 2, " Win Rate", str.tostring(math.round(wr, 1)) + "%", color.white, wr_bg)

    pf_bg = pf >= 1.5 ? color.new(bull_col, 30) : pf >= 1.0 ? color.new(#ff9800, 40) : color.new(bear_col, 40)
    f_row(0, 3, " Profit Factor", str.tostring(math.round(pf, 2)), color.white, pf_bg)

    net_bg = net > 0 ? color.new(bull_col, 30) : color.new(bear_col, 40)
    f_row(0, 4, " Net P/L", str.tostring(math.round(net, 2)), color.white, net_bg)

    f_row(0, 5, " Wins / Losses", str.tostring(wins) + " / " + str.tostring(losses), color.white, color.new(color.gray, 60))

    ema_txt = ema_stack_bull ? "▲ BULL" : ema_stack_bear ? "▼ BEAR" : "— MIXED"
    ema_bg  = ema_stack_bull ? color.new(bull_col, 50) : ema_stack_bear ? color.new(bear_col, 50) : color.new(color.gray, 60)
    f_row(0, 6, " EMA Stack", ema_txt, color.white, ema_bg)

    htf_txt = htf_bull ? "▲ HTF Bull" : "▼ HTF Bear"
    htf_bg  = htf_bull ? color.new(bull_col, 50) : color.new(bear_col, 50)
    f_row(0, 7, " HTF Trend", htf_txt, color.white, htf_bg)

    adx_bg = adx_ok ? color.new(#00bcd4, 40) : color.new(color.gray, 65)
    f_row(0, 8, " ADX", str.tostring(math.round(adx, 1)), color.white, adx_bg)

    sess_bg = in_session ? color.new(#00bcd4, 40) : color.new(color.gray, 65)
    f_row(0, 9, " Session", in_session ? "ACTIVE" : "CLOSED", color.white, sess_bg)

    pos_txt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_bg  = strategy.position_size > 0 ? color.new(bull_col, 30) : strategy.position_size < 0 ? color.new(bear_col, 30) : color.new(color.gray, 60)
    f_row(0, 10, " Position", pos_txt, color.white, pos_bg)

    f_row(0, 11, " Trades Today", str.tostring(day_trades) + " / " + str.tostring(max_trades_day), color.white, color.new(color.gray, 60))

// ══════════════════════════════════════════════════════════════
// BACKGROUND
// ══════════════════════════════════════════════════════════════
bg_col = ema_stack_bull and htf_bull ? color.new(bull_col, 93) : ema_stack_bear and htf_bear ? color.new(bear_col, 93) : na
bgcolor(show_bg ? bg_col : na, title="Trend Background")
